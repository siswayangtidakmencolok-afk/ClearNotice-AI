GEMINI_API_KEY=your_gemini_api_key_here
# Retained for the inactive Gemini integration. Current analysis routes do not call Gemini.
GEMINI_MODEL=gemini-3.8-flash

# OpenRouter Free is the primary and only AI provider in current analysis routes.
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=openrouter/free

# Cohere reranks retrieved passages; it does not verify factual truth.
COHERE_API_KEY=your_cohere_api_key_here
COHERE_RERANK_MODEL=rerank-v5.0-fast
COHERE_MIN_RELEVANCE_SCORE=0

# Existing Neon Postgres connection; document storage requires the migration.
DATABASE_URL=your_neon_database_url_here
